# Copia questo file in `.env.local` e riempilo con i valori del tuo progetto Supabase.
# `.env.local` e' in .gitignore: le chiavi non finiscono mai nel repo.
#
# Dove trovarli: dashboard Supabase -> Project Settings -> API Keys
#   - VITE_SUPABASE_URL      = "Project URL"
#   - VITE_SUPABASE_ANON_KEY = "anon / public key" (nelle versioni recenti
#                              si chiama "Publishable key", inizia con sb_publishable_)
#
# NON usare mai la chiave `service_role` / `secret`: bypassa la Row Level Security.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
